{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build_core_debug_fast",
            "type": "shell",
            "command": "make core_debug_fast",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build_core_debug",
            "type": "shell",
            "command": "make core_debug",
            "group": {
                "kind": "build"
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build_core",
            "type": "shell",
            "command": "make core",
            "group": {
                "kind": "build"
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "set_intellisense_debug",
            "type": "shell",
            "command": "cp .clangd-debug .clangd",
            "problemMatcher": []
        },
        {
            "label": "set_intellisense_release",
            "type": "shell",
            "command": "cp .clangd-release .clangd",
            "problemMatcher": []
        }
    ]
}
